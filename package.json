{
  "name": "weekcraft",
  "version": "0.6.1",
  "private": true,
  "description": "Weekly planning, grouped Kanban tasks, and completion timestamps for Obsidian.",
  "author": "heheeeeeeer",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/heheeeeeeer/obsidian-weekcraft.git" },
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node build.mjs",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.js",
    "install:local": "node scripts/install-local.mjs",
    "check": "npm test && node scripts/check-release.mjs",
    "release:prepare": "npm run check && node scripts/prepare-release.mjs"
  }
}
